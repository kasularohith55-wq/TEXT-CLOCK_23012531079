<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <!-- Card container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/clockCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardUseCompatPadding="true"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/card_background"
            android:padding="20dp">

            <!-- AM/PM chip -->
            <TextView
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                android:text="AM"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent"/>

            <!-- Large time -->
            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="28dp"
                android:text="12:34"
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="@color/accent"/>

            <!-- Seconds small, to the right of time -->
            <TextView
                android:id="@+id/secondsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/timeText"
                android:layout_alignBaseline="@id/timeText"
                android:layout_marginStart="8dp"
                android:text="45"
                android:textSize="22sp"
                android:textColor="@color/muted"/>

            <!-- Date -->
            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/timeText"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:text="Wed, Apr 23 2025"
                android:textSize="16sp"
                android:textColor="@color/muted"/>

            <!-- Subtle pulse animation view -->
            <View
                android:id="@+id/pulse"
                android:layout_width="150dp"
                android:layout_height="4dp"
                android:layout_below="@id/dateText"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="18dp"
                android:background="@drawable/pulse_gradient"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
